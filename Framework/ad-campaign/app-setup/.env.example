# Copy relevant lines into your own shell/session as real environment
# variables — most shells do not load .env files automatically. See
# app-setup/README.md's "Configuration reference" section for what each one
# does. Everything here is optional; the defaults in application.properties
# already match a fresh local dev setup created via app-setup's install
# guide.

# DB_URL=jdbc:postgresql://localhost:5432/adcampaign
# DB_USERNAME=adcampaign
# DB_PASSWORD=adcampaign

# JWT_SECRET=replace-with-a-real-random-secret-at-least-32-bytes
# JWT_EXPIRATION_MINUTES=60

# ADMIN_BOOTSTRAP_EMAIL=

# BIDSCUBE_SHARED_SECRET=
# BIDSCUBE_TENANT_ID=
# BIDSCUBE_WIN_NOTICE_BASE_URL=
